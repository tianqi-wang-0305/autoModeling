{
  "model": "EMB_LRM_LaneRoleManager.slx",
  "scope": "blk_59",
  "layout_mode": "full",
  "operations": [
    {"op": "add_block", "type": "Inport", "name": "u8HeartbeatLostCount", "ref": "hbin"},
    {"op": "add_block", "type": "Outport", "name": "u8HbFailure", "ref": "hbout"},
    {"op": "add_block", "type": "UnitDelay", "name": "UnitDelay_PrevCount", "ref": "ud"},
    {"op": "add_block", "type": "Constant", "name": "C_One", "ref": "c1"},
    {"op": "add_block", "type": "Sum", "name": "Sum_PrevPlus1", "ref": "sum1"},
    {"op": "add_block", "type": "RelationalOperator", "name": "Relop_IsIncrement", "ref": "eqinc"},
    {"op": "add_block", "type": "Constant", "name": "C_Max255", "ref": "c255"},
    {"op": "add_block", "type": "RelationalOperator", "name": "Relop_PrevIs255", "ref": "eqprev"},
    {"op": "add_block", "type": "Constant", "name": "C_Zero", "ref": "c0"},
    {"op": "add_block", "type": "RelationalOperator", "name": "Relop_CurrIs0", "ref": "eqcurr"},
    {"op": "add_block", "type": "Logic", "name": "Logic_AndWrap", "ref": "andwrap"},
    {"op": "add_block", "type": "Logic", "name": "Logic_OrHealthy", "ref": "orhlth"},
    {"op": "add_block", "type": "Logic", "name": "Logic_NotFailure", "ref": "notfail"},
    {"op": "add_block", "type": "DataTypeConversion", "name": "Dtc_ToU8", "ref": "dtc"},
    {"op": "configure", "target": "#hbin", "params": {"OutDataTypeStr": "uint8", "Description": "心跳丢失计数；类型 uint8；范围 0..255"}},
    {"op": "configure", "target": "#hbout", "params": {"Description": "心跳丢失故障判断；类型 uint8；范围 0..1 (0=Not Failure,1=Failure)"}},
    {"op": "configure", "target": "#ud", "params": {"InitialCondition": "0", "StateDataTypeStr": "uint8", "Description": "保存上一周期心跳丢失计数，用于判定连续递增"}},
    {"op": "configure", "target": "#c1", "params": {"Value": "1", "OutputDataTypeStr": "uint8", "Description": "递增步长常量 1；uint8"}},
    {"op": "configure", "target": "#sum1", "params": {"Inputs": "++", "Description": "上一周期计数 +1（uint8 溢出自动回卷）"}},
    {"op": "configure", "target": "#eqinc", "params": {"Operator": "==", "Description": "当前计数 == 上一周期+1（正常递增）"}},
    {"op": "configure", "target": "#c255", "params": {"Value": "255", "OutputDataTypeStr": "uint8", "Description": "最大值常量 255；uint8"}},
    {"op": "configure", "target": "#eqprev", "params": {"Operator": "==", "Description": "上一周期计数 == 255"}},
    {"op": "configure", "target": "#c0", "params": {"Value": "0", "OutputDataTypeStr": "uint8", "Description": "零常量；uint8"}},
    {"op": "configure", "target": "#eqcurr", "params": {"Operator": "==", "Description": "当前计数 == 0"}},
    {"op": "configure", "target": "#andwrap", "params": {"Operator": "AND", "Inputs": "2", "Description": "回卷检测：上一周期==255 且当前==0"}},
    {"op": "configure", "target": "#orhlth", "params": {"Operator": "OR", "Inputs": "2", "Description": "健康条件：正常递增 或 回卷"}},
    {"op": "configure", "target": "#notfail", "params": {"Operator": "NOT", "Inputs": "1", "Description": "故障条件：健康条件取反"}},
    {"op": "configure", "target": "#dtc", "params": {"OutDataTypeStr": "uint8", "Description": "boolean 转 uint8 输出"}},
    {"op": "connect", "target": "#hbin.y1 -> #ud.u1"},
    {"op": "connect", "target": "#hbin.y1 -> #eqinc.u1"},
    {"op": "connect", "target": "#hbin.y1 -> #eqcurr.u1"},
    {"op": "connect", "target": "#ud.y1 -> #sum1.u1"},
    {"op": "connect", "target": "#c1.y1 -> #sum1.u2"},
    {"op": "connect", "target": "#sum1.y1 -> #eqinc.u2"},
    {"op": "connect", "target": "#c255.y1 -> #eqprev.u2"},
    {"op": "connect", "target": "#ud.y1 -> #eqprev.u1"},
    {"op": "connect", "target": "#c0.y1 -> #eqcurr.u2"},
    {"op": "connect", "target": "#eqprev.y1 -> #andwrap.u1"},
    {"op": "connect", "target": "#eqcurr.y1 -> #andwrap.u2"},
    {"op": "connect", "target": "#eqinc.y1 -> #orhlth.u1"},
    {"op": "connect", "target": "#andwrap.y1 -> #orhlth.u2"},
    {"op": "connect", "target": "#orhlth.y1 -> #notfail.u1"},
    {"op": "connect", "target": "#notfail.y1 -> #dtc.u1"},
    {"op": "connect", "target": "#dtc.y1 -> #hbout.u1"}
  ]
}
