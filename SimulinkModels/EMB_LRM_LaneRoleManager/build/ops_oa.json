    {"op": "configure", "target": "#rd1", "params": {"Operator": "==", "Description": "远程角色==DISABLED"}},
    {"op": "configure", "target": "#rd2", "params": {"Operator": "==", "Description": "远程角色==SHUTTING_DOWN"}},
    {"op": "configure", "target": "#orfail", "params": {"Operator": "OR", "Inputs": "2", "Description": "远程禁用或关闭 -> FAILED"}},
    {"op": "configure", "target": "#rinv", "params": {"Operator": "==", "Description": "远程健康度==255（无效）-> HB_LOST"}},
    {"op": "configure", "target": "#run", "params": {"Operator": "==", "Description": "远程角色==UNKNOWN"}},
    {"op": "configure", "target": "#rin", "params": {"Operator": "==", "Description": "远程角色==INIT"}},
    {"op": "configure", "target": "#orinit", "params": {"Operator": "OR", "Inputs": "2", "Description": "远程 UNKNOWN/INIT -> INITIALISING"}},
    {"op": "configure", "target": "#swf", "params": {"Description": "状态映射优先级 1：禁用/关闭 -> FAILED(3)"}},
    {"op": "configure", "target": "#swh", "params": {"Description": "状态映射优先级 2：健康度无效 -> HB_LOST(2)"}},
    {"op": "configure", "target": "#swi", "params": {"Description": "状态映射优先级 3：UNKNOWN/INIT -> INITIALISING(0)，否则 OPERATING(1)"}},
