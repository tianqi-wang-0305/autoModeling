    {"op": "configure", "target": "#kc2", "params": {"Value": "2", "OutDataTypeStr": "uint8", "Description": "常量 2（LN_ROLE_MASTER）；uint8"}},
    {"op": "configure", "target": "#kc3", "params": {"Value": "3", "OutDataTypeStr": "uint8", "Description": "常量 3（LANE_STS_FAILED）；uint8"}},
    {"op": "configure", "target": "#kc5", "params": {"Value": "5", "OutDataTypeStr": "uint8", "Description": "常量 5（LN_ROLE_DISABLED）；uint8"}},
